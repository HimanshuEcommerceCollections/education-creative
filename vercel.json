{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "regions": ["iad1"],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [
    {
      "path": "/bookings/cron/sweep-unconfirmed",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/auth/cron/purge-sessions",
      "schedule": "30 4 * * *"
    }
  ]
}
