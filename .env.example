# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored; this template is committed.
# `src/env.ts` parses these with Zod and refuses to boot if any are invalid.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4100
LOG_LEVEL=debug

# Hosted Postgres (Neon / Render). Neon requires sslmode=require.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# The Next.js origin. Used for links in emails and as the CORS allowlist.
WEB_ORIGIN=http://localhost:3000

# Secrets — generate fresh per environment, never reuse across envs:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Session tokens are hashed with this pepper before storage, so rotating it
# invalidates every existing session.
SESSION_PEPPER=change-me-32-bytes-base64url
# 32 raw bytes, base64. Encrypts learner first names and in-home addresses.
FIELD_ENCRYPTION_KEY=change-me-32-bytes-base64

# ---------------------------------------------------------------------------
# Email. Business logic only ever sees the EmailService interface, so switching
# provider is this one line plus that provider's settings — never a code change.
#
#   console — prints the message and any link to stdout. No account needed for
#             local development. Rejected in production.
#   smtp    — Gmail, SES-over-SMTP, Mailgun, Brevo, Postmark, Mailpit.
#             Needs outbound 587/465, which some hosts block.
#   resend  — HTTPS on 443. Works anywhere.
#   ses     — AWS SES over the HTTPS API, on 443. Works anywhere.
# ---------------------------------------------------------------------------
EMAIL_DRIVER=console
EMAIL_FROM="Your Learning Journey <no-reply@example.com>"

# --- smtp ---
# Gmail: SMTP_USER is the full address; SMTP_PASSWORD is a 16-character App
# Password (https://myaccount.google.com/apppasswords, requires 2-Step
# Verification) — not the account password. Spaces in it are stripped.
# Keep EMAIL_FROM equal to SMTP_USER: Gmail rewrites or rejects anything else.
# Port and TLS must agree — 587 with SMTP_SECURE=false, 465 with true.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Development only. When set, the console driver appends every message to this
# path as JSONL, which is how the e2e suite reads single-use tokens. Writes live
# tokens in plaintext, so production boot rejects it.
EMAIL_OUTBOX_FILE=

# --- resend ---
RESEND_API_KEY=

# --- ses ---
# Omit both AWS keys to use an ambient IAM role instead (preferred in production).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=

# --- stripe -----------------------------------------------------------------
# All four are required together, or leave all four blank. A half-configured
# Stripe can charge a card and then never confirm it, because the webhook that is
# the only source of payment truth can't be verified without its signing secret.
#
# Prefer a *restricted* key (rk_...) scoped to Checkout Sessions, PaymentIntents,
# Refunds and Events — nothing here needs the rest of the account.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Production refuses test-mode Stripe keys unless this is explicitly set. Use it
# for a soft launch on test keys; at go-live, swap the keys to live mode AND
# remove this flag (a live key with the flag still set is rejected).
STRIPE_ALLOW_TEST_MODE=false

# From the webhook endpoint you register in the Stripe dashboard. Each endpoint
# has its own secret; rotating one without updating this silently stops every
# payment from being recorded.
STRIPE_WEBHOOK_SECRET=

# WHICH PROJECT OWNS AN OBJECT, when several projects share one Stripe account.
#
# Not a label — a safety mechanism. A Stripe account delivers every subscribed
# event to EVERY registered webhook endpoint, so this service will receive other
# projects' payment events. Since a succeeded payment with no local booking is
# refunded automatically, an unfiltered endpoint would refund a sibling project's
# revenue. Every object we create is tagged with this value and the webhook drops
# anything that doesn't match.
#
# Two projects must never share a value. A separate Stripe account (or at least a
# separate sandbox) per project is still better — see src/lib/stripe.ts.
STRIPE_PROJECT_KEY=ylj

# First-admin bootstrap, consumed by `npm run seed:admin`.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-min-10-chars
SEED_ADMIN_NAME=Platform Admin

# Rate limiting needs no configuration: the limiter is in-process.
