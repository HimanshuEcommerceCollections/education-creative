# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored; this template is committed.
# `src/env.ts` parses these with Zod and refuses to boot if any are invalid.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4100
LOG_LEVEL=debug

# Hosted Postgres (Neon / Render). Neon requires sslmode=require.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# The Next.js origin. Used for links in emails and as the CORS allowlist.
WEB_ORIGIN=http://localhost:3000

# Secrets — generate fresh per environment, never reuse across envs:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Session tokens are hashed with this pepper before storage, so rotating it
# invalidates every existing session.
SESSION_PEPPER=change-me-32-bytes-base64url
# 32 raw bytes, base64. Encrypts learner first names and in-home addresses.
FIELD_ENCRYPTION_KEY=change-me-32-bytes-base64

# Staff TOTP. Set false in dev to skip enrolment and the second login step;
# must be true in production (src/env.ts enforces this).
MFA_REQUIRED=false

# EmailService driver. `console` prints the message (and any verification or
# invite link) to stdout — no provider account needed for local development.
EMAIL_DRIVER=console
EMAIL_FROM="Your Learning Journey <no-reply@example.com>"
# Required when EMAIL_DRIVER=resend
RESEND_API_KEY=
# Required when EMAIL_DRIVER=smtp
SMTP_URL=

# First-admin bootstrap, consumed by `npm run seed:admin`.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-min-10-chars
SEED_ADMIN_NAME=Platform Admin
